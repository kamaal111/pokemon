{
  "name": "pokemon-api",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "compile": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
    "dev": "tsx watch --inspect src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.2",
    "@hono/standard-validator": "^0.2.2",
    "@kamaalio/kamaal": "^0.8.0",
    "hono": "^4.12.18",
    "hono-openapi": "^1.3.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
