{
  "name": "pokemon-api",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "db:check": "drizzle-kit check",
    "compile": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset-local": "tsx src/database/reset-local.ts",
    "db:up": "drizzle-kit up",
    "dev": "tsx watch --inspect src/index.ts",
    "seed:pokedex": "tsx src/seed/cli.ts",
    "start": "node dist/index.js",
    "test": "vitest --run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.2",
    "@hono/standard-validator": "^0.2.2",
    "@kamaalio/kamaal": "^0.8.0",
    "@libsql/client": "^0.15.15",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.12.18",
    "hono-openapi": "^1.3.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@vitest/coverage-v8": "4.1.5",
    "drizzle-kit": "^0.31.5",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
